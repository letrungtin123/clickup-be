NODE_ENV=development
LOG_LEVEL=info
API_HOST=127.0.0.1
API_PORT=3890
WEB_ORIGIN=http://127.0.0.1:5890
# Comma-separated extra browser origins (e.g. the PM2 Vite app on 5276, LAN addresses)
ADDITIONAL_CORS_ORIGINS=

# Self-hosted Supabase
SUPABASE_URL=http://127.0.0.1:56321
SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_JWT_SECRET=replace-with-supabase-jwt-secret
SUPABASE_JWT_ISSUER=http://127.0.0.1:56321/auth/v1
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
STORAGE_BUCKET=nesso-work-files
AUTH_COOKIE_SECURE=false

# PostgreSQL (Supavisor session pooler)
DATABASE_URL=postgresql://postgres.your-tenant-id:replace-with-local-password@127.0.0.1:56322/postgres
DATABASE_SSL=false

# Redis + RabbitMQ (infra/docker-compose.yml)
REDIS_URL=redis://:replace-with-redis-password@127.0.0.1:56379/0
RABBITMQ_URL=amqp://nesso_work:replace-with-rabbitmq-password@127.0.0.1:56672/nesso-work

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10
ACCESS_CONTEXT_CACHE_TTL_SECONDS=60
